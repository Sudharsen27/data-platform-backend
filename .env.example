# Copy to ".env" in this folder (backend/.env). Do not commit real secrets.

# Local Postgres on your machine (uvicorn outside Docker). Host must be localhost or 127.0.0.1.
# Docker Compose: do NOT rely on this file — set POSTGRES_* in mini-mdm-platform/.env instead.
# Render: leave unset; Render injects DATABASE_URL (postgres:// or postgresql:// — both supported).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mdm_platform

# JWT — use a long random value in production (same secret across instances that must validate tokens).
JWT_SECRET_KEY=change-me-in-production
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated admin emails; role is set to admin on each startup.
ADMIN_EMAILS=you@example.com

# Used only when that email is NOT in users yet: creates admin with this password.
ADMIN_BOOTSTRAP_PASSWORD=

# Set true only when you need existing admin users’ passwords to match ADMIN_BOOTSTRAP_PASSWORD
# (one deploy/restart, then set back to false). Values: true / false / 1 / 0 / yes / no.
ADMIN_BOOTSTRAP_SYNC_PASSWORD=false

# Browser origin allowed by CORS (add your production frontend URL).
FRONTEND_URL=http://localhost:3000

# Optional Snowflake — set false when trial ends; app uses Postgres only.
# SNOWFLAKE_ENABLED=false
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SYNC_SCHEDULER_ENABLED=false
# SYNC_INTERVAL_MINUTES=10
# PIPELINE_SCHEDULER_ENABLED=false
# PIPELINE_INTERVAL_MINUTES=60
# PIPELINE_SCHEDULER_CRON=0 2 * * *
# Rows per INSERT batch when syncing Postgres → Snowflake (avoids 200k expression limit).
# SNOWFLAKE_SYNC_BATCH_SIZE=10000

# AI copilot — works on any laptop without Azure or a local GPU.
# heuristic     = rule-based (default, no extra install)
# groq          = Groq cloud LLM (requires GROQ_API_KEY)
# azure_openai  = Azure OpenAI (requires endpoint, key, deployment; falls back to Groq)
# ollama        = local LLM when Ollama is running (optional upgrade)
AI_ENABLED=true
AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT_SECONDS=60
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_TIMEOUT_SECONDS=60
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=90
